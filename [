import LeitorTexto as leitorTexto


class Voz:
    voz_texto = ""


class GerenciadorVozes:
    vozes = []

    def criar_vozes(self, texto: leitorTexto.LeitorTexto()):
        for linha in texto.linhas:
            voz = Voz()
            voz.voz_texto = linha
            self.vozes.append(voz)

    def get_vozes(self):
        print(len(self.vozes))
        for voz in self.vozes:
            print(voz.voz_texto)


# Gerenciador Musica
campoTexto = leitorTexto.LeitorTexto()

campoTexto.get_texto()

gerenciador_vozes = GerenciadorVozes()
gerenciador_vozes.criar_vozes(campoTexto)

gerenciador_vozes.get_vozes()
